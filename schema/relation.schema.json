{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gps-kataster-obiektow-tatr/schema/relation.schema.json",
  "$defs": {
    "ObjectId": {
      "pattern": "^[A-Z]{2,3}-[0-9]{4,}$",
      "type": "string"
    },
    "RelationId": {
      "pattern": "^R-[0-9]{4,}$",
      "type": "string"
    },
    "SchemaVersion": {
      "const": 1
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "#/$defs/RelationId"
    },
    "from_object_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "to_object_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "relation_type": {
      "enum": [
        "sasiad",
        "czesc_systemu",
        "mozliwy_duplikat",
        "inne"
      ],
      "title": "Relation Type",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "schema_version",
    "id",
    "from_object_id",
    "to_object_id",
    "relation_type"
  ],
  "title": "Relacja",
  "type": "object"
}
