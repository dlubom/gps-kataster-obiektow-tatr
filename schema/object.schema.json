{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gps-kataster-obiektow-tatr/schema/object.schema.json",
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "$ref": "#/$defs/TimestampString"
        },
        "created_by": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/AttachmentId"
        },
        "kind": {
          "enum": [
            "raport_gnss",
            "zdjecie",
            "inne"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "measurement_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "created_at",
        "created_by",
        "id",
        "kind",
        "path"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "AttachmentId": {
      "pattern": "^a-[0-9]{3,}$",
      "type": "string"
    },
    "AutoBestMeasurement": {
      "additionalProperties": false,
      "properties": {
        "updated_at": {
          "$ref": "#/$defs/TimestampString"
        },
        "updated_by": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "measurement_id": {
          "$ref": "#/$defs/MeasurementId"
        },
        "mode": {
          "const": "auto",
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "updated_at",
        "updated_by",
        "measurement_id",
        "mode"
      ],
      "title": "AutoBestMeasurement",
      "type": "object"
    },
    "AutoIdAssignment": {
      "additionalProperties": false,
      "properties": {
        "assigned_from_measurement_id": {
          "$ref": "#/$defs/MeasurementId"
        },
        "assigned_prefix": {
          "$ref": "#/$defs/Prefix"
        },
        "method": {
          "const": "auto",
          "title": "Method",
          "type": "string"
        },
        "prefix_override_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix Override Reason"
        }
      },
      "required": [
        "assigned_from_measurement_id",
        "assigned_prefix",
        "method"
      ],
      "title": "AutoIdAssignment",
      "type": "object"
    },
    "BestMeasurement": {
      "discriminator": {
        "mapping": {
          "auto": "#/$defs/AutoBestMeasurement",
          "manual": "#/$defs/ManualBestMeasurement"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AutoBestMeasurement"
        },
        {
          "$ref": "#/$defs/ManualBestMeasurement"
        }
      ]
    },
    "CaveId": {
      "pattern": "^C-[0-9]{4,}$",
      "type": "string"
    },
    "DateString": {
      "format": "date",
      "type": "string"
    },
    "ExternalReference": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "TPN",
            "PIG",
            "geoportal",
            "NR_INWENT",
            "inne"
          ],
          "title": "System",
          "type": "string"
        },
        "ref_type": {
          "enum": [
            "source_globalid",
            "inventory_number",
            "catalog_id",
            "url",
            "source_row",
            "other"
          ],
          "title": "Ref Type",
          "type": "string"
        },
        "external_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/UriString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "object",
                "cave",
                "cave_system",
                "inventory_entry",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "system",
        "ref_type",
        "external_id"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "FiniteNumber": {
      "maximum": 1.7976931348623157e+308,
      "minimum": -1.7976931348623157e+308,
      "type": "number"
    },
    "IdAssignment": {
      "discriminator": {
        "mapping": {
          "auto": "#/$defs/AutoIdAssignment",
          "manual": "#/$defs/ManualIdAssignment"
        },
        "propertyName": "method"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AutoIdAssignment"
        },
        {
          "$ref": "#/$defs/ManualIdAssignment"
        }
      ]
    },
    "Latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
    },
    "Longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
    },
    "ManualBestMeasurement": {
      "additionalProperties": false,
      "properties": {
        "updated_at": {
          "$ref": "#/$defs/TimestampString"
        },
        "updated_by": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "measurement_id": {
          "$ref": "#/$defs/MeasurementId"
        },
        "mode": {
          "const": "manual",
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "updated_at",
        "updated_by",
        "measurement_id",
        "mode",
        "reason"
      ],
      "title": "ManualBestMeasurement",
      "type": "object"
    },
    "ManualIdAssignment": {
      "additionalProperties": false,
      "properties": {
        "assigned_from_measurement_id": {
          "$ref": "#/$defs/MeasurementId"
        },
        "assigned_prefix": {
          "$ref": "#/$defs/Prefix"
        },
        "method": {
          "const": "manual",
          "title": "Method",
          "type": "string"
        },
        "prefix_override_reason": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "assigned_from_measurement_id",
        "assigned_prefix",
        "method",
        "prefix_override_reason"
      ],
      "title": "ManualIdAssignment",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "$ref": "#/$defs/TimestampString"
        },
        "created_by": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/MeasurementId"
        },
        "lat": {
          "$ref": "#/$defs/Latitude"
        },
        "lon": {
          "$ref": "#/$defs/Longitude"
        },
        "x_1992": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "y_1992": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "elevation_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "elevation_datum": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "ellipsoidal",
                "PL-EVRF2007-NH",
                "Kronstadt86",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Datum"
        },
        "elevation_source": {
          "anyOf": [
            {
              "enum": [
                "gps",
                "gnss",
                "map",
                "dem",
                "barometric",
                "source_record",
                "unknown",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Source"
        },
        "horizontal_accuracy_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeNumber"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vertical_accuracy_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeNumber"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "enum": [
            "TPN",
            "PIG",
            "geoportal",
            "wlasne",
            "publikacja",
            "inne"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimestampString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_date": {
          "$ref": "#/$defs/DateString"
        },
        "source_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "enum": [
            "gps_receiver",
            "gnss",
            "smartfon",
            "mapa_topo",
            "source_record",
            "siec_pomiarowa",
            "ustalenie",
            "inne"
          ],
          "title": "Method",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "tags": {
          "$ref": "#/$defs/UniqueList_NonEmptyString_"
        },
        "verification_status": {
          "enum": [
            "nieweryfikowany",
            "zweryfikowany",
            "odrzucony"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "verified_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimestampString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "id",
        "lat",
        "lon",
        "x_1992",
        "y_1992",
        "source",
        "observed_date",
        "method",
        "verification_status"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MeasurementId": {
      "pattern": "^m-[0-9]{3,}$",
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "NonNegativeNumber": {
      "maximum": 1.7976931348623157e+308,
      "minimum": 0,
      "type": "number"
    },
    "ObjectId": {
      "pattern": "^[A-Z]{2,3}-[0-9]{4,}$",
      "type": "string"
    },
    "Prefix": {
      "pattern": "^[A-Z]{2,3}$",
      "type": "string"
    },
    "SchemaVersion": {
      "const": 1
    },
    "TimestampString": {
      "format": "date-time",
      "pattern": "^\\S+(?![\\s\\S])",
      "type": "string"
    },
    "UniqueList_Attachment_": {
      "items": {
        "$ref": "#/$defs/Attachment"
      },
      "type": "array",
      "uniqueItems": true
    },
    "UniqueList_ExternalReference_": {
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "type": "array",
      "uniqueItems": true
    },
    "UniqueList_NonEmptyString_": {
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "type": "array",
      "uniqueItems": true
    },
    "UriString": {
      "format": "uri",
      "pattern": "^\\S+(?![\\s\\S])",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "updated_at": {
      "$ref": "#/$defs/TimestampString"
    },
    "updated_by": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "created_at": {
      "$ref": "#/$defs/TimestampString"
    },
    "created_by": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "#/$defs/ObjectId"
    },
    "category": {
      "enum": [
        "jaskinia_otwor",
        "ponor",
        "wywierzysko",
        "sztolnia",
        "inne"
      ],
      "title": "Category",
      "type": "string"
    },
    "name_local": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name Local"
    },
    "cave_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaveId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id_assignment": {
      "$ref": "#/$defs/IdAssignment"
    },
    "external_refs": {
      "$ref": "#/$defs/UniqueList_ExternalReference_"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "minItems": 1,
      "title": "Measurements",
      "type": "array"
    },
    "best_measurement": {
      "$ref": "#/$defs/BestMeasurement"
    },
    "attachments": {
      "$ref": "#/$defs/UniqueList_Attachment_"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "updated_at",
    "updated_by",
    "created_at",
    "created_by",
    "schema_version",
    "id",
    "category",
    "id_assignment",
    "external_refs",
    "measurements",
    "best_measurement",
    "attachments"
  ],
  "title": "Obiekt",
  "type": "object"
}
