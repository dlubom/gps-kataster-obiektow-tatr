{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gps-kataster-obiektow-tatr/schema/cave.schema.json",
  "$defs": {
    "CaveId": {
      "pattern": "^C-[0-9]{4,}$",
      "type": "string"
    },
    "ExternalReference": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "TPN",
            "PIG",
            "geoportal",
            "NR_INWENT",
            "inne"
          ],
          "title": "System",
          "type": "string"
        },
        "ref_type": {
          "enum": [
            "source_globalid",
            "inventory_number",
            "catalog_id",
            "url",
            "source_row",
            "other"
          ],
          "title": "Ref Type",
          "type": "string"
        },
        "external_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/UriString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "object",
                "cave",
                "cave_system",
                "inventory_entry",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "system",
        "ref_type",
        "external_id"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "ObjectId": {
      "pattern": "^[A-Z]{2,3}-[0-9]{4,}$",
      "type": "string"
    },
    "SchemaVersion": {
      "const": 1
    },
    "TimestampString": {
      "format": "date-time",
      "pattern": "^\\S+(?![\\s\\S])",
      "type": "string"
    },
    "UniqueList_ExternalReference_": {
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "type": "array",
      "uniqueItems": true
    },
    "UniqueList_ObjectId_": {
      "items": {
        "$ref": "#/$defs/ObjectId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "UriString": {
      "format": "uri",
      "pattern": "^\\S+(?![\\s\\S])",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "updated_at": {
      "$ref": "#/$defs/TimestampString"
    },
    "updated_by": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "created_at": {
      "$ref": "#/$defs/TimestampString"
    },
    "created_by": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "#/$defs/CaveId"
    },
    "name": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "system_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Name"
    },
    "external_refs": {
      "$ref": "#/$defs/UniqueList_ExternalReference_"
    },
    "object_ids": {
      "$ref": "#/$defs/UniqueList_ObjectId_"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "updated_at",
    "updated_by",
    "created_at",
    "created_by",
    "schema_version",
    "id",
    "name",
    "external_refs",
    "object_ids"
  ],
  "title": "Jaskinia",
  "type": "object"
}
